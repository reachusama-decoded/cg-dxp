    direction LR
    H1["source_freshness_check<br/><b>success</b>"] --> H2["dbt_pipeline<br/>success"] --> H3["publish_to_catalog<br/>success"]
  end
  class G1 red
  class G2,G3 grey
  class H1,H2,H3 green
