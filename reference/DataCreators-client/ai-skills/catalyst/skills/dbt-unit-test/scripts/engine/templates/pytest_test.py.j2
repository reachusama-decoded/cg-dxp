    def test_{{ tc.test_id | lower }}_no_unexpected_nulls(self):
        """Columns present in expected output must not be all-null."""
        for exp_row in self.EXPECTED_OUTPUT:
            for col, val in exp_row.items():
                if val is not None and col in self.result_df.columns:
                    # Skip if the seed itself had null/missing for this column —
                    # an LLM inconsistency (null seed but non-null assertion).
                    seeded_non_null = any(
                        row.get(col) is not None
                        for rows_list in self.INPUT_DATA.values()
                        for row in rows_list
                        if col in row
                    )
                    # Only skip when the seed lacks the output column AND result_df
                    # also has no non-null values — the SQL may have renamed it
                    # from a differently-named source column (rename/transform model).
                    result_non_null = (
                        col in self.result_df.columns
                        and self.result_df[col].notna().any()
                    )
                    if not seeded_non_null and not result_non_null:
                        pytest.skip(
                            f"[{{ tc.test_id }}] Column '{col}' was seeded as null "
                            f"but expected non-null value {val!r} — seed/assertion inconsistency."
                        )
                    non_null_count = self.result_df[col].notna().sum()
                    assert non_null_count > 0, (
                        f"[{{ tc.test_id }}] Column '{col}' is entirely NULL in output "
                        f"but expected value: {val!r}"
                    )
