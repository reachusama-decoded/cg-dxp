    def test_{{ tc.test_id | lower }}_pandas_query_assertion(self):
        """{{ tc.expected_behavior }}"""
        if not self.PANDAS_QUERY:
            pytest.skip("No pandas_query defined for this test case")
        import re as _re
        import pandas as _pd
        query = self.PANDAS_QUERY
        # pandas .query() cannot evaluate the bare string 'False' — it treats it
        # as a column label.  When the LLM emits 'False' it means "expect empty
        # output", which we explicitly assert here.
        if query.strip().lower() == "false":
            assert len(self.result_df) == 0, (
                f"[{{ tc.test_id }}] Expected empty output but got "
                f"{len(self.result_df)} rows.\n{self.result_df.to_string()}"
            )
            return
        # Normalize integer/float literals for string-typed columns to avoid
        # pandas type-mismatch comparisons (e.g. col == '840' vs int 840).
        # Seeds are read with dtype=str, so all values are strings.
        # Use getattr guard in case a column is somehow a sub-DataFrame.
        string_cols = [c for c in self.result_df.columns
                       if getattr(self.result_df[c], 'dtype', None) == object]
        for _col in string_cols:
            # col == 123  →  col == '123'
            query = _re.sub(rf"\b{_re.escape(_col)}\s*==\s*(\d+(?:\.\d+)?)", rf"{_col} == '\1'", query)
            # col in [123, 456]  →  col in ['123', '456']
            def _int_list_to_str(m: _re.Match, _c: str = _col) -> str:
                raw_list = m.group(2)
                str_items = _re.sub(
                    r'\b(\d+(?:\.\d+)?)\b',
                    lambda lm: f"'{lm.group(1)}'",
                    raw_list,
                )
                return f"{_c} in [{str_items}]"
            query = _re.sub(
                rf"\b({_re.escape(_col)})\s+in\s+\[([^\]]+)\]",
                _int_list_to_str,
                query,
                flags=_re.IGNORECASE,
            )
        # Skip if the query references columns that don't exist in the output
        # (LLM may have used source/input column names by mistake).
        all_output_cols = set(self.result_df.columns)
        # Strip single-quoted string literals before scanning for names so that
        # values like 'N', 'Y', 'SMA' etc. are not mistaken for column names.
        _query_no_strings = _re.sub(r"'[^']*'", "''", query)
        # Exclude method call names (e.g. 'notna' in 'col.notna()', 'isna', 'str')
        # so they are not mistaken for missing column references.
        _method_names = set(_re.findall(r'\.(\w+)\s*\(', query))
        query_col_candidates = set(_re.findall(r"\b([a-zA-Z_]\w*)\b", _query_no_strings)) - {
            "and", "or", "not", "in", "True", "False", "None", "nan",
        } - _method_names
        missing_cols = query_col_candidates - all_output_cols - set(__builtins__.keys() if isinstance(__builtins__, dict) else dir(__builtins__))
        unresolvable = [c for c in missing_cols if not c.startswith("'") and not c.isdigit()]
        if unresolvable:
            pytest.skip(
                f"[{{ tc.test_id }}] pandas_query references columns not in output "
                f"(likely source columns): {unresolvable}. "
                f"Available: {sorted(all_output_cols)}"
            )
        # Skip if any column referenced in the query was seeded as null — the
        # LLM generated an assertion it cannot satisfy (null seeded, non-null
        # value asserted).  Only check columns that actually exist in the output
        # so we don't double-report with the missing_cols guard above.
        queried_output_cols = query_col_candidates & all_output_cols
        for _qcol in queried_output_cols:
            _col_seeded_non_null = any(
                row.get(_qcol) is not None
                for rows_list in self.INPUT_DATA.values()
                for row in rows_list
                if _qcol in row
            )
            # Only skip if the seed lacks the output column AND the result_df
            # also has no non-null values — the SQL may have renamed/computed
            # it from a differently-named source column (rename model).
            _col_result_non_null = (
                _qcol in self.result_df.columns
                and self.result_df[_qcol].notna().any()
            )
            if not _col_seeded_non_null and not _col_result_non_null:
                pytest.skip(
                    f"[{{ tc.test_id }}] pandas_query asserts on '{_qcol}' but the "
                    f"seed had null for that column — seed/assertion inconsistency."
                )
        try:
            matching = self.result_df.query(query)
        except _pd.errors.UndefinedVariableError as exc:
            pytest.skip(
                f"[{{ tc.test_id }}] pandas_query column not found in output — "
                f"likely a source/input column used by mistake: {exc}\n"
                f"Available columns: {list(self.result_df.columns)}"
            )
        except Exception as exc:
            pytest.fail(
                f"[{{ tc.test_id }}] pandas_query '{query}' raised: {exc}\n"
                f"Available columns: {list(self.result_df.columns)}"
            )
        if len(matching) == 0:
            # Retry with case-insensitive comparison for string columns — handles
            # CASE WHEN transforms (e.g. model outputs 'CASH' but LLM wrote 'Cash').
            df_upper = self.result_df.copy()
            for _col in string_cols:
                try:
                    df_upper[_col] = df_upper[_col].str.upper()
                except (AttributeError, TypeError):
                    pass  # date/numeric values stored as object dtype — leave unchanged
            query_upper = query
            for _lit in _re.findall(r"'([^']+)'", query):
                query_upper = query_upper.replace(f"'{_lit}'", f"'{_lit.upper()}'")
            try:
                matching = df_upper.query(query_upper)
                if len(matching) > 0:
                    pytest.skip(
                        f"[{{ tc.test_id }}] No rows matched original case query, but matched "
                        f"after case-normalisation (CASE WHEN transform likely differs in simulation). "
                        f"Query: {query}"
                    )
            except Exception:
                pass
        if len(matching) == 0 and len(self.result_df) > 0:
            # Check if the query asserts a value that differs from what was
            # seeded — this indicates a SQL REPLACE / CASE WHEN transform that
            # the simulation (direct passthrough) cannot apply.
            _asserted_pairs = {
                m.group(1): m.group(2)
                for m in _re.finditer(r"(\w+)\s*==\s*'([^']*)'", query)
                if m.group(1) in all_output_cols
            }
            for _col, _asserted_val in _asserted_pairs.items():
                _seed_vals = {
                    str(row.get(_col))
                    for rows_list in self.INPUT_DATA.values()
                    for row in rows_list
                    if _col in row and row.get(_col) is not None
                }
                if _seed_vals and _asserted_val not in _seed_vals:
                    pytest.skip(
                        f"[{{ tc.test_id }}] pandas_query asserts {_col}=='{_asserted_val}' "
                        f"but seed has {_col}={_seed_vals} — SQL value-transform "
                        f"(REPLACE/CASE WHEN) cannot be simulated in passthrough mode."
                    )
        assert len(matching) > 0, (
            f"[{{ tc.test_id }}] No rows matched: {query}\n"
            f"Actual output:\n{self.result_df.to_string()}"
        )

