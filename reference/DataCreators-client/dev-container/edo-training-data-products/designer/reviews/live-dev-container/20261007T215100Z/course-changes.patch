+#!/usr/bin/env python3
+"""Verify reviewed demo PDF/HTML/media at desktop/mobile sizes in an owned server."""
+import argparse,functools,hashlib,http.server,importlib.util,json,re,socketserver,threading,time
+from pathlib import Path
+import fitz
+from playwright.sync_api import sync_playwright
+ROOT=Path(__file__).resolve().parents[1]
+
+class QuietHandler(http.server.SimpleHTTPRequestHandler):
+    def log_message(self,*args):pass
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('--bundle',type=Path,required=True);ap.add_argument('--report',type=Path,required=True);a=ap.parse_args();bundle=a.bundle.resolve();a.report.parent.mkdir(parents=True,exist_ok=True)
+    spec=importlib.util.spec_from_file_location('prepare',ROOT/'scripts/prepare-instructor-demo-course.py');module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);models=module.verify(bundle)
+    report={'bundle_sha256':hashlib.sha256((bundle/'bundle.json').read_bytes()).hexdigest(),'stories':[m['id'] for m in models],'method':'PyMuPDF text/image/link bounds; real Chromium HTTP playback, caption loading, copy and desktop/mobile checks','errors':[],'display_pilot':'Browser emulation only; projector/human viewing still pending'}
+    pdf=bundle/'DataCreators-Instructor-Demos.pdf'
+    if pdf.exists():
+        doc=fitz.open(pdf);bounds=[];sizes=[]
+        for number,page in enumerate(doc,1):
+            for b in page.get_text('dict')['blocks']:
+                box=fitz.Rect(b['bbox'])
+                if box.x0<-1 or box.y0<-1 or box.x1>page.rect.width+1 or box.y1>page.rect.height+1:bounds.append({'page':number,'bbox':list(box)})
+            for image in page.get_images():
+                for box in page.get_image_rects(image[0]):sizes.append({'page':number,'width_pt':round(box.width,2),'height_pt':round(box.height,2),'essential_terminal_type_pt':round(21*box.width/1100,2)})
+        report['pdf']={'pages':len(doc),'outside_page_bounds':bounds,'images':sizes,'links':sum(len(p.get_links()) for p in doc),'selectable_caption_and_command_text':all(m['title'] in ''.join(p.get_text() for p in doc) for m in models)}
+        if bounds:report['errors'].append('PDF content outside page bounds')
+        if not report['pdf']['selectable_caption_and_command_text']:report['errors'].append('Missing PDF story text')
+        (a.report.parent/'demo-pdf-first-story.png').write_bytes(doc[2].get_pixmap(matrix=fitz.Matrix(100/72,100/72)).tobytes('png'))
+    server_spec=importlib.util.spec_from_file_location('demo_server',bundle/'serve.py')
+    if not server_spec.loader:raise ValueError('Missing portable media server')
+    server_module=importlib.util.module_from_spec(server_spec);server_spec.loader.exec_module(server_module)
+    class BundleHandler(server_module.RangeHandler):
+        def log_message(self,*args):pass
+    server=socketserver.ThreadingTCPServer(('127.0.0.1',0),functools.partial(BundleHandler,directory=str(bundle)))
+    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start();url=f'http://127.0.0.1:{server.server_address[1]}/'
+    report['owned_server']={'address':url,'cleanup':'pending'}
+    try:
+        with sync_playwright() as p:
+            browser=p.chromium.launch();context=browser.new_context(permissions=['clipboard-read','clipboard-write']);page=context.new_page();failures=[];aborted=[]
+            def request_failure(req):
+                item={'url':req.url,'reason':req.failure}
+                # Reloading/seeking media and changing viewport/navigation can
+                # cancel a preload. Retain it separately; playback must pass.
+                (aborted if req.failure=='net::ERR_ABORTED' else failures).append(item)
+            page.on('requestfailed',request_failure);page.on('pageerror',lambda error:failures.append(str(error)))
+            page.on('response',lambda response:failures.append({'url':response.url,'status':response.status}) if response.status>=400 else None)
+            page.goto(url);page.wait_for_load_state('networkidle')
+            report['html']={'article_count':page.locator('article').count(),'request_errors':failures,'cancelled_preloads':aborted,'video_playback':[]}
+            assert page.locator('article').count()==len(models)
+            for index in range(page.locator('video').count()):
+                video=page.locator('video').nth(index)
+                video.evaluate('(v)=>v.load()')
+                page.wait_for_function('(index)=>document.querySelectorAll("video")[index].readyState>=2',arg=index,timeout=20000)
+                video.evaluate('(v)=>v.play()');page.wait_for_timeout(250)
+                evidence=video.evaluate('(v)=>({duration:v.duration,currentTime:v.currentTime,paused:v.paused,captionTracks:v.textTracks.length,cues:v.textTracks[0]?.cues?.length,videoWidth:v.videoWidth,videoHeight:v.videoHeight})')
+                assert evidence['currentTime']>0 and evidence['duration']>0 and evidence['captionTracks']==1 and evidence['cues']>0,evidence
+                video.evaluate('''(v)=>new Promise((resolve,reject)=>{
+                    v.pause();const target=v.duration/2;
+                    const timeout=setTimeout(()=>reject(new Error("Video seek timed out")),15000);
+                    v.addEventListener("seeked",()=>{clearTimeout(timeout);resolve(v.currentTime)}, {once:true});
+                    v.currentTime=target;
+                })''')
+                evidence['seekTime']=video.evaluate('(v)=>v.currentTime')
+                assert abs(evidence['seekTime']-evidence['duration']/2)<.5,evidence
+                report['html']['video_playback'].append(evidence)
+            button=page.locator('.copy').first;expected=button.evaluate('(b)=>b.previousElementSibling.textContent');button.click();assert page.evaluate('navigator.clipboard.readText()')==expected
+            report['html']['copy_exact_command']=True
+            page.keyboard.press('Tab');report['html']['keyboard_focus']=page.evaluate('document.activeElement.tagName')
+            for width,height,label in [(1366,768,'desktop'),(390,844,'mobile')]:
+                page.set_viewport_size({'width':width,'height':height});page.goto(url);page.wait_for_load_state('networkidle')
+                overflow=page.evaluate('document.documentElement.scrollWidth>innerWidth')
+                report['html'][label]={'viewport':[width,height],'horizontal_page_overflow':overflow}
+                assert not overflow
+                page.screenshot(path=str(a.report.parent/f'demo-html-{label}.png'),full_page=False)
+            assert not failures,failures
+            browser.close()
+    except Exception as e:report['errors'].append(str(e))
+    finally:server.shutdown();server.server_close();thread.join();report['owned_server']['cleanup']='stopped owned server'
+    report['passed']=not report['errors'];a.report.write_text(json.dumps(report,indent=2)+'\n');print(json.dumps({'passed':report['passed'],'report':str(a.report),'errors':report['errors']},indent=2))
+    if report['errors']:raise SystemExit(1)
+if __name__=='__main__':main()
