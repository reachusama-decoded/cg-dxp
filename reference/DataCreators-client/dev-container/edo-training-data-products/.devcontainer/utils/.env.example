# Databricks Configuration
# =======================
# Copy this file to .env and fill in your values
# Command (Linux/Mac): cd .devcontainer && cp utils/.env.example .env
#
# NOTE: You can optionally use quotes around values - they will be automatically stripped:
#   DATABRICKS_HOST=https://...               (works)
#   DATABRICKS_HOST="https://..."             (also works)
#   DATABRICKS_HOST='https://...'             (also works)
#
# After creating your .env file, rebuild the devcontainer for changes to take effect.

# Databricks Workspace Configuration
# -----------------------------------
# Your Databricks workspace URL (NO QUOTES)
# This is the training environment workspace. Leave as is.
# Example: DATABRICKS_HOST=https://cg-db-aa00003661-dev-us-east-1.cloud.databricks.com
DATABRICKS_HOST=https://cg-db-aa00003661-dev-us-east-1.cloud.databricks.com

# Your Databricks personal access token (NO QUOTES)
# Generate from: User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=dapi1234567890abcdefg

# SQL Warehouse or Cluster HTTP Path (NO QUOTES)
# Find in: SQL Warehouses -> [Your Warehouse] -> Connection Details -> HTTP Path
# Example: DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/56c5feb545393772
# This warehouse is the default one in the training environment.
# You can create your own if you like. If not, just use this one.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/267dd55b7f7395ce

# Databricks Catalog for local contract development (NO QUOTES)
# The Unity Catalog name to use for local contract migrations (e.g. caspian_ig_dev)
# Leave as is
DATABRICKS_CATALOG=training_dev

# Per-data-product S3 locations for external tables (NO QUOTES).
# Only needed if the data product's contract has 'external: true' on the schema object.
# Must be under a registered External Location in Databricks.
# The contract:migrate task automatically appends /${DATABRICKS_SCHEMA} so each developer
# gets an isolated S3 prefix (e.g. s3://.../caspian_ig_dev/dev_nick/currency_v4).
# Add one line per data product that uses external tables:
# DATABRICKS_LOCATION_ASSET_REFERENCE_DATA=s3://your-bucket/your-catalog
# DATABRICKS_LOCATION_ORDERS=s3://your-bucket/your-catalog

# Your personal schema name for local contract development (NO QUOTES)
# Used by contract:init and contract:migrate (e.g. dev_yourname)
# Please add your initials to the end of the schema and remove the brackets
# Example: DATABRICKS_SCHEMA=training_gqp
DATABRICKS_SCHEMA=training_{your_initials_here}