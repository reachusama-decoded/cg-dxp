# Template only. The course devcontainer setup (mise run setup:databricks) supplies
# DATABRICKS_HOST, DATABRICKS_HTTP_PATH and DBT_ACCESS_TOKEN; never commit a token.
DBT_CATALOG=
DBT_SCHEMA=
DC_RELATION_PREFIX=
# Absolute paths inside the course devcontainer, set for your working product.
CG_CLIENT_ROOT=
CG_PRODUCT_ROOT=
# Airflow reads paths, DAG IDs and owned prefixes from this product folder and its
# .capstone-workspace.json; no worker settings are needed here.
