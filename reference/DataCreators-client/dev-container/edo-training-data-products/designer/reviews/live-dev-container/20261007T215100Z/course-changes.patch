new file mode 100644
index 0000000..377c9bf
--- /dev/null
+++ b/scripts/instructor-demo-filter.lua
@@ -0,0 +1,35 @@
+-- Reviewed bundle only. Run prepare-instructor-demo-course.py before rendering.
+-- This filter consumes static assets and never executes a capture/workload.
+local bundle = os.getenv('INSTRUCTOR_DEMO_BUNDLE')
+local function read(path)
+  local handle = assert(io.open(path, 'r'), 'Missing reviewed demo asset: ' .. path)
+  local text = handle:read('*a'); handle:close(); return text
+end
+local function pattern(text) return text:gsub('([%(%)%.%%%+%-%*%?%[%]%^%$])', '%%%1') end
+function Div(el)
+  if not el.classes:includes('instructor-demo') then return nil end
+  assert(bundle and bundle ~= '', 'INSTRUCTOR_DEMO_BUNDLE is required')
+  local id = el.attributes.story
+  assert(id and id:match('^[a-z][a-z0-9%-]*$'), 'Invalid instructor story ID')
+  local model = pandoc.json.decode(read(bundle .. '/stories/' .. id .. '/story.json'))
+  assert(model.review and model.review.verdict == 'approved for candidate export', 'Unreviewed story')
+  if FORMAT:match('latex') then
+    local fragment = read(bundle .. '/stories/' .. id .. '/story.tex')
+    -- The wrapper already starts a fresh page. An empty hyperlink anchor before
+    -- a second clearpage otherwise creates an unwanted blank course page.
+    fragment = fragment:gsub('^\\clearpage\n', '', 1)
+    fragment = fragment:gsub('{stories/', '{demos/stories/')
+    fragment = fragment:gsub('run:index.html', 'run:demos/index.html')
+    -- Keep the complete native fragment, continuous page counters and links.
+    return pandoc.RawBlock('latex', '\\clearpage\\begingroup\\pagestyle{plain}\\setlength{\\parskip}{2pt}\\setlength{\\parindent}{0pt}\\savegeometry{beforeinstructordemo}\\newgeometry{margin=12mm}\n\\hypertarget{demo-' .. id .. '}{}\n' .. fragment .. '\n\\clearpage\\loadgeometry{beforeinstructordemo}\\endgroup\n')
+  elseif FORMAT:match('html') then
+    local library = read(bundle .. '/index.html')
+    local article = assert(library:match('(<article id="' .. pattern(id) .. '".->.-</article>)'), 'Missing HTML story')
+    article = article:gsub('src="stories/', 'src="demos/stories/')
+    article = article:gsub('href="stories/', 'href="demos/stories/')
+    local style = '<style>.instructor-demo img,.instructor-demo video{max-width:100%;height:auto}.instructor-demo figure{margin:1rem 0}.instructor-demo figcaption{background:#eef4f5;padding:.7rem}.instructor-demo pre{overflow:auto}.instructor-demo button{padding:.6rem}.instructor-demo a:focus,.instructor-demo button:focus{outline:3px solid #187577}</style>'
+    local script = '<script>for(const b of document.querySelectorAll(".instructor-demo .copy:not([data-wired])")){b.dataset.wired="true";b.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(b.previousElementSibling.textContent);b.textContent="Copied"}catch(e){b.textContent="Select the command above to copy"}})}</script>'
+    return pandoc.RawBlock('html', style .. '<div class="instructor-demo">' .. article .. '</div>' .. script)
