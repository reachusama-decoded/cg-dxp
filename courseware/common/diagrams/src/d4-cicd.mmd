flowchart LR
  B["feature branch"] --> PR["pull request<br/>review"] --> Mg["merge"]
  Mg -->|webhook| H["Harness pipeline"]
  H --> SQA["SQA<br/>shared: check who<br/>deployed last"]
  SQA --> PRD["Production<br/>release branch + CRQ"]
  PRD --> As["Astro + Databricks"]
