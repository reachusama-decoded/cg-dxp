+#!/usr/bin/env python3
+"""Verify a portable demo bundle and prepare course overlays without editing chapters."""
+import argparse,hashlib,json,re,shutil
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+ANCHORS={'docker-images-and-containers':('03-day-3-data-systems.md','v2-03-0113'),'dbt-models-and-tests':('03-day-3-data-systems.md','v2-03-0969'),'airflow-run-and-recovery':('04-day-4-orchestration-systems.md','v2-04-0413')}
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def verify(bundle):
+    index=json.loads((bundle/'bundle.json').read_text())
+    for relative,digest in index['files'].items():
+        path=(bundle/relative).resolve()
+        if not path.is_relative_to(bundle.resolve()) or not path.is_file() or sha(path)!=digest:raise ValueError('Missing/corrupt reviewed asset '+relative)
+    models=[]
+    for ident in index['stories']:
+        if not re.fullmatch('[a-z][a-z0-9-]*',ident):raise ValueError('Unsafe story ID')
+        model=json.loads((bundle/'stories'/ident/'story.json').read_text())
+        if model['id']!=ident or model['review']['verdict']!='approved for candidate export':raise ValueError('Unreviewed or mismatched story')
+        for cp in model['checkpoints']:
+            if sha(bundle/cp['frame'])!=cp['frame_sha256']:raise ValueError('Bad frame digest')
+        models.append(model)
+    return models
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('--bundle',type=Path,required=True);ap.add_argument('--output',type=Path);ap.add_argument('--check',action='store_true');a=ap.parse_args()
+    models=verify(a.bundle.resolve())
+    if a.check:print('Portable bundle verified:',len(models),'reviewed stories');return
+    if not a.output:ap.error('--output required for an overlay')
+    if a.output.exists():raise ValueError('Overlay destination exists; choose a fresh candidate')
+    out=a.output.resolve();(out/'learner').mkdir(parents=True)
+    chapters={p.name:p.read_text() for p in (ROOT/'learner').glob('[0-9][0-9]-*.md')};source_hashes={p.name:sha(p) for p in (ROOT/'learner').glob('[0-9][0-9]-*.md')}
+    placements=[]
+    for m in models:
+        if not m['main_book']['include']:continue
+        key=m['main_book']['teaching_key'];filename,anchor=ANCHORS[key];text=chapters[filename]
+        match=list(re.finditer(r'^(#{1,6}) .*\{#'+re.escape(anchor)+r'\}\s*$',text,re.M))
+        if len(match)!=1:raise ValueError('Teaching anchor moved/ambiguous; resolve before integration: '+anchor)
+        owner=match[0];level=len(owner[1]);end=re.search(r'^#{1,'+str(level)+r'} (?!#)',text[owner.end():],re.M)
+        position=owner.end()+end.start() if end else len(text)
+        block='\n::: {.instructor-demo story="'+m['id']+'"}\n::: \n\n'
+        chapters[filename]=text[:position]+block+text[position:]
+        placements.append({'story_id':m['id'],'teaching_key':key,'source':filename,'after_section_anchor':anchor,'run_id':m['run_id']})
+    for name,text in chapters.items():(out/'learner'/name).write_text(text)
+    shutil.copytree(a.bundle,out/'demos')
+    for rel in ['scripts/instructor-demo-filter.lua','pdf/headers/instructor-demos.tex']:
+        destination=out/rel;destination.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(ROOT/rel,destination)
+    (out/'integration.json').write_text(json.dumps({'course_source_hashes':source_hashes,'placements':placements,'selection':json.loads((a.bundle/'selection.json').read_text()),'status':'prepared overlay; full course render/content/HTML/package acceptance pending','builder_additions':{'filters.local':[{'path':'scripts/instructor-demo-filter.lua','before':'extra'}],'headers.extra':['pdf/headers/navigation.tex','pdf/headers/instructor-demos.tex'],'package.copy':[{'from':'demos','to':'demos','name':'instructor_demo_assets_sha256'}]},'build_environment':'INSTRUCTOR_DEMO_BUNDLE points at overlay/demos; copy overlay learner files and adapters into an isolated snapshot of current course before building'},indent=2)+'\n')
+    print(out)
+if __name__=='__main__':main()
