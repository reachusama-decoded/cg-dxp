{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "fixtures",
    "independent_expected",
    "model_graph",
    "runtime",
    "commands",
    "pending_live",
    "pending_human"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "case",
          "source_path",
          "delivery_path",
          "sha256",
          "raw_count",
          "columns",
          "source_relation"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_count": {
            "type": "integer",
            "minimum": 0
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "adapter",
        "targets",
        "schema_policy",
        "credentials",
        "versions"
      ],
      "properties": {
        "adapter": {
          "const": "dbt-databricks"
        },
        "targets": {
          "const": [
            "local",
            "dev",
            "airflow"
          ]
        }
      }
    },
    "pending_live": {
      "type": "array",
      "minItems": 1
    },
    "pending_human": {
      "type": "array",
      "minItems": 1
    }
  }
}
