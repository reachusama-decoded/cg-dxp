# Confluence/Jira Cloud credentials
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-api-token

# Jira Cloud credentials (often same as Confluence)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-api-token

# -----------------------------------------------------------------------------
# Jira ticket automation defaults (used by the jira-create-epics-stories skill)
#
# Default project to create issues in:
JIRA_PROJECT_KEY=
# Optional: default sprint (numeric sprint ID)
JIRA_DEFAULT_SPRINT_ID=
# Optional: where to write plan/result markdown reports
JIRA_REPORTS_DIR=workspace/docs/jira
# Optional: issue type names (only override if your Jira uses non-standard names)
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_STORY_ISSUE_TYPE=Story
JIRA_TASK_ISSUE_TYPE=Task
# Optional: issue link type name
JIRA_DEFAULT_LINK_TYPE=Relates
# Optional: how to associate children to epics (auto|epic_link|parent)
# - auto: next-gen → parent, classic → Epic Link (when resolvable)
JIRA_CHILD_ASSOCIATION=auto
# Optional: override field IDs if auto-discovery doesn't match your instance
JIRA_EPIC_NAME_FIELD_ID=
JIRA_EPIC_LINK_FIELD_ID=
JIRA_SPRINT_FIELD_ID=

# Optional: Jira HTTP reliability / rate limiting behavior
# If Jira returns HTTP 429, the client will honor Retry-After when present; otherwise it uses
# exponential backoff (bounded). These tune that behavior.
JIRA_HTTP_MAX_RETRIES=5
JIRA_HTTP_RETRY_BASE_DELAY=1.0
JIRA_HTTP_RETRY_MAX_DELAY=30.0

# Optional: emit retry logs to stderr (0/1). Useful when diagnosing throttling.
JIRA_HTTP_LOG_RETRIES=0
JIRA_HTTP_DEBUG=0

# GitHub credentials (for private repos)
# Leave blank to use git credential helper or SSH keys
GITHUB_TOKEN=

# Databricks authentication
# Recommended for interactive work: an OAuth login, which needs no secret here
# and is preferred over a PAT (DBX-SEC-002). This writes ~/.databrickscfg, which
# the SDK reads automatically:
#   databricks auth login --host https://your-workspace.cloud.databricks.com
# Not sure which workspace, or whether you have access? Run /dplc-preflight.
#
# For non-interactive / service-to-service use, DBX-SEC-002 requires OAuth client
# credentials for a service principal -- set these two and leave DATABRICKS_TOKEN
# unset. /connect-databricks refuses to run if DATABRICKS_TOKEN is present.
#   DATABRICKS_CLIENT_ID=your-service-principal-client-id
#   DATABRICKS_CLIENT_SECRET=your-service-principal-secret

# Optional: convenience setting used by scripts/dbx_sql.py
# This does NOT provide credentials; it only selects which Databricks config profile to use.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional: default SQL Warehouse ID used by scripts/dbx_sql.py and profiling skills
# This does NOT provide credentials.
DATABRICKS_WAREHOUSE_ID=

# Optional: Default catalog/schema for Unity Catalog queries
DATABRICKS_DEFAULT_CATALOG=
DATABRICKS_DEFAULT_SCHEMA=

# Optional: run-as identity for serverless jobs. Leave blank in most cases —
# the submit script auto-detects via `databricks current-user me`. Only set
# this when overriding (e.g. running as a service principal). Do NOT set it
# to a schema's `created_by` value; that's provisioning history (often an
# admin / elevated account) and won't match what the CLI is authed as.
DATABRICKS_RUN_AS_USER=

# -----------------------------------------------------------------------------
# dbt: generated project prototyping (recommended: PAT token)
#
# Used by `workspace/generated/dbt_project/profiles.yml` after patching.
#
# WARNING: setting DATABRICKS_TOKEN here also makes /connect-databricks refuse to
# run -- it rejects the variable unconditionally (DBX-SEC-002), even though that
# standard scopes the ban to non-interactive service-to-service calls. If you hit
# "DATABRICKS_TOKEN detected", that is why. Keep the dbt token in the dbt
# profiles.yml rather than the process environment, or unset it for the session.
#
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Optional: separate catalogs for dbt execution
# - DBT_SOURCE_CATALOG: where dbt `source()` tables live (e.g., cspn_dev1)
# - DBT_DATABRICKS_CATALOG: where dbt materializes models (e.g., platform_dev)
DBT_SOURCE_CATALOG=
DBT_DATABRICKS_CATALOG=

# === Marketplace ===
# Both default to production marketplace; override only for staging or testing.
# MARKETPLACE_UI_BASE_URL=https://marketplace.capgroup.com
# MARKETPLACE_API_BASE_URL=https://marketplace-service.datalake.aws.capgroup.com

# -----------------------------------------------------------------------------
# Skill behavior tests (tests/behavior/)
#
# LLM endpoint (the runner agent + judge). Pick ONE of three options:
#
# A. Claude Code session (default; Mac/Linux only).
#    Leave all three blank — claude-agent-sdk reuses your Claude Code OAuth.
#
# B. Anthropic API direct.
#    Set ANTHROPIC_API_KEY=<your key>. Bills to the key's account.
#
# C. Databricks-hosted Claude (recommended for Capital Group teammates).
#    Set ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN. The base URL points at
#    Databricks' Anthropic-compatible AI Gateway endpoint; the auth token
#    is a model-scoped Databricks PAT (workspace → Serving → Integrate
#    coding agents → Generate API key).
#    If the SDK's request format trips compat issues with Databricks'
#    gateway (older releases rejected `context_management` and
#    `?beta=true`), point ANTHROPIC_BASE_URL at the local proxy instead:
#       bin/bt proxy &      # starts proxy on http://127.0.0.1:19999
#       export ANTHROPIC_BASE_URL=http://127.0.0.1:19999
#
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Only set the next three if you're using `bin/bt proxy` to bridge to
# Databricks. The proxy reads these; the SDK reads ANTHROPIC_BASE_URL above.
DATABRICKS_ANTHROPIC_BASE_URL=
DATABRICKS_ANTHROPIC_TOKEN=
# DATABRICKS_PROXY_PORT=19999  # default
# Stable Databricks reference table — used by behavior tests as groundedness target.
# Should be a catalog/schema where cg_employee_v4 (or similar stable reference) lives.
TEST_CATALOG=
TEST_SCHEMA=
# Optional — separate Databricks creds for the test harness, so test runs don't
# compete with skill-using sessions for warehouse capacity. If unset, falls back
# to DATABRICKS_HOST / DATABRICKS_TOKEN / DATABRICKS_WAREHOUSE_ID above.
TEST_DATABRICKS_HOST=
TEST_DATABRICKS_TOKEN=
TEST_DATABRICKS_WAREHOUSE_ID=
# Stable Confluence reference page — groundedness target for load-confluence-context tests.
# Default is the Index Data Product Proposal in the IIKF space.
TEST_CONFLUENCE_PAGE_ID=143164794
TEST_CONFLUENCE_PAGE_TITLE=Index Data Product Proposal
TEST_CONFLUENCE_SPACE=IIKF
